      "parameters": {
        "jsCode": "const raw = $json.choices[0].message.content;\nlet ideas;\ntry {\n  ideas = JSON.parse(raw);\n} catch(e) {\n  const match = raw.match(/\\[.*\\]/s);\n  if (!match) throw new Error('Cannot parse LLM response: ' + raw.substring(0, 200));\n  ideas = JSON.parse(match[0]);\n}\nideas.sort((a,b) => (b.scores?.total || b.total || 0) - (a.scores?.total || a.total || 0));\nconst reel = ideas.find(i => i.format === 'Reel');\nconst post = ideas.find(i => i.format === 'Post');\nconst story = ideas.find(i => i.format === 'Story');\nconst top3 = [reel, post, story].filter(Boolean);\nif (top3.length < 3) {\n  for (const idea of ideas) {\n    if (top3.length >= 3) break;\n    if (!top3.includes(idea)) top3.push(idea);\n  }\n}\nreturn [{json: {top3, parsed_ok: true}}];"
