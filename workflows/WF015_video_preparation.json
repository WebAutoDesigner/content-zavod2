    {
      "id": "normalize-video-015",
      "name": "Code: normalize candidate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        280
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const first = $input.first()?.json;\nconst video = Array.isArray(first) ? first[0] : first;\n\nif (!video || !video.id) {\n  return [{ json: { has_video: false, action: 'no_selected_video', message: 'No selected competitor videos waiting for preparation.' } }];\n}\n\nreturn [{\n  json: {\n    has_video: true,\n    video_id: video.id,\n    batch_id: video.batch_id,\n    competitor_account_id: video.competitor_account_id,\n    video_url: video.video_url,\n    thumbnail_url: video.thumbnail_url,\n    selection_type: video.selection_type,\n    selection_score: video.selection_score,\n    selection_reason: video.selection_reason,\n    views: video.views,\n    views_multiplier: video.views_multiplier,\n    caption: video.caption || ''\n  }\n}];"
      }
    },
    {
      "id": "if-video-015",
      "name": "IF: has video?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        860,
        280
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
