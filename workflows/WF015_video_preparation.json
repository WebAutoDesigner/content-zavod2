      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1140,
        140
      ],
      "parameters": {
        "url": "={{ 'https://xxnzqridvepixzireqjh.supabase.co/rest/v1/competitor_videos?id=eq.' + $json.video_id }}",
        "method": "PATCH",
