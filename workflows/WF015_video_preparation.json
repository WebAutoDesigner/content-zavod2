              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ status: 'raw_saved', updated_at: new Date().toISOString() }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "prepare-media-015",
      "name": "FFmpeg: prepare transcript frames audio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "onError": "continueRegularOutput",
      "position": [
        1420,
        140
      ],
      "parameters": {
        "url": "http://85.239.59.252:8003/prepare_competitor_video",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ video_id: $('Code: normalize candidate').item.json.video_id, video_url: $('Code: normalize candidate').item.json.video_url, thumbnail_url: $('Code: normalize candidate').item.json.thumbnail_url, polza_api_key: '{{POLZA_API_KEY}}', analysis_instructions: { language: 'ru', purpose: 'competitor viral reel analysis for premium custom tables', must_extract: ['speech transcript with timestamps','on-screen text/OCR','first-frame hook','scene timeline','hands/install/product/body-without-face visual cues','brand/logo risks','face/person risks','audio mood/BPM/energy/drop','why this could hold attention'], do_not_discard: 'Do not discard videos only because hands/body/logo appear; mark risks and let WF02 decide.' } }) }}"
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 10000
    },
    {
      "id": "build-analysis-015",
      "name": "Code: build analysis row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1700,
        140
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const prep = $input.first().json;\nconst source = $('Code: normalize candidate').item.json;\n\nif (!prep.success) {\n  return [{\n    json: {\n      ok: false,\n      video_id: source.video_id,\n      batch_id: source.batch_id,\n      error: prep.error || prep.message || 'Video preparation failed',\n      update_body: { status: 'failed', updated_at: new Date().toISOString() }\n    }\n  }];\n}\n\nconst now = new Date().toISOString();\nconst transcript = prep.transcript || {};\nconst vision = prep.vision || {};\nconst audio = prep.audio || {};\nconst files = prep.files || {};\n\nconst sceneTimeline = Array.isArray(vision.scene_timeline_json) ? vision.scene_timeline_json : [];\nif (Array.isArray(vision.visual_hooks) && vision.visual_hooks.length) {\n  sceneTimeline.push({ type: 'visual_hooks', items: vision.visual_hooks });\n}\nif (Array.isArray(vision.brand_or_logo_risks) && vision.brand_or_logo_risks.length) {\n  sceneTimeline.push({ type: 'brand_or_logo_risks', items: vision.brand_or_logo_risks });\n}\nif (Array.isArray(vision.face_or_person_risks) && vision.face_or_person_risks.length) {\n  sceneTimeline.push({ type: 'face_or_person_risks', items: vision.face_or_person_risks });\n}\n\nconst analysis = {\n  competitor_video_id: source.video_id,\n  audio_storage_path: files.audio || null,\n  keyframes_storage_paths: files.frames || [],\n  preview_storage_path: files.preview || null,\n  speech_transcript: transcript.text || '',\n  speech_segments_json: transcript.segments || [],\n  screen_text_json: vision.screen_text_json || [],\n  scene_timeline_json: sceneTimeline,\n  visual_summary: vision.visual_summary || '',\n  audio_bpm: audio.bpm || null,\n  audio_energy: audio.energy || null,\n  audio_genre: audio.genre || null,\n  audio_drop_seconds: audio.drop_seconds || audio.drop_time || null,\n  ocr_confidence: vision.ocr_confidence || null,\n  transcription_model: prep.models?.transcription || 'openai/gpt-4o-transcribe',\n  vision_model: prep.models?.vision || 'openai/gpt-5.2',\n  audio_analysis_tool: audio.tool || 'ffmpeg-server-basic-audio',\n  status: 'ready_for_pattern',\n  created_at: now,\n  updated_at: now\n};\n\nreturn [{\n  json: {\n    ok: true,\n    video_id: source.video_id,\n    batch_id: source.batch_id,\n    raw_video_storage_path: files.original || null,\n    analysis,\n    update_body: {\n      status: 'ready_for_pattern',\n      raw_video_storage_path: files.original || null,\n      updated_at: now\n    }\n  }\n}];"
      }
    },
