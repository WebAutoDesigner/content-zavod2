    },
    {
      "id": "telegram-result-05",
      "name": "Code: Telegram send result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1840,
        140
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const built = $('Code: build Telegram requests').all().map(i => i.json);\nconst responses = $input.all().map(i => i.json);\nconst pkg = built[0]?.package_id || $('Code: pick ready package').first().json.package.id;\nreturn [{ json: { package_id: pkg, sent_count: responses.length, requested_count: built.length } }];"
      }
    }
