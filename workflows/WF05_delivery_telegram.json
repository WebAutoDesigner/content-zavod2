      "typeVersion": 2,
      "position": [
        1980,
        140
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: { action: 'delivered', message: 'Package videos sent to Telegram and package marked delivered.' } }];"
      }
    },
