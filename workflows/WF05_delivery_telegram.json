      "name": "IF: has package?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        860,
        280
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
