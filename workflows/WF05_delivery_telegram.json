    },
    {
      "id": "send-05",
      "name": "Code: build Telegram requests",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1420,
        140
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const token = \"{{TELEGRAM_BOT_TOKEN}}\";\nconst chatId = \"1347534574\";\nconst pkg = $('Code: pick ready package').first().json.package;\nconst assets = $input.all().flatMap(i => Array.isArray(i.json) ? i.json : [i.json]).filter(a => a && a.id);\nconst order = ['reel_close', 'reel_premium', 'reel_viral', 'story'];\nconst label = { reel_close: 'Reel 1 - close pattern', reel_premium: 'Reel 2 - premium', reel_viral: 'Reel 3 - viral', story: 'Story' };\nconst sortedVideos = assets.filter(a => order.includes(a.asset_type)).sort((a, b) => order.indexOf(a.asset_type) - order.indexOf(b.asset_type));\nconst workerBase = 'https://dark-field-8e65.nikitagpt2114.workers.dev';\nconst videos = [];\nconst failed = [];\n\nfunction sourceUrl(asset) {\n  const storage = String(asset.storage_url || '');\n  if (storage.startsWith('http')) return storage;\n  const file = String(asset.file_path || '');\n  if (file.startsWith('http')) return file;\n  return '';\n}\n\nfunction localFilePath(asset) {\n  const file = String(asset.file_path || '');\n  if (file.startsWith('/root/')) return file;\n  return '';\n}\n\nfor (const asset of sortedVideos) {\n  const caption = [label[asset.asset_type] || asset.asset_type, asset.caption || '', asset.cta ? 'CTA: ' + asset.cta : '']\n    .filter(Boolean)\n    .join('\\n\\n')\n    .slice(0, 1000);\n  const filePath = localFilePath(asset);\n  const url = sourceUrl(asset);\n  if (!filePath && !url) {\n    failed.push({ id: asset.id, asset_type: asset.asset_type, reason: 'No local file_path or downloadable URL' });\n    continue;\n  }\n  videos.push({\n    id: asset.id,\n    asset_type: asset.asset_type,\n    file_path: filePath,\n    storage_url: url,\n    caption,\n  });\n}\n\nconst captionLines = sortedVideos.map(asset =>\n  [label[asset.asset_type] || asset.asset_type, asset.caption ? 'Caption: ' + asset.caption : '', asset.cta ? 'CTA: ' + asset.cta : '']\n    .filter(Boolean)\n    .join('\\n')\n);\nconst failureLine = failed.length ? 'Not sent: ' + failed.map(f => f.asset_type + ' - ' + f.reason).join('; ') : '';\nconst summary = ['Package ready: ' + (pkg.package_date || pkg.id), '', ...captionLines, failureLine, '', 'Reply: published 1 2 3, revise second, all ok, send links again.']\n  .filter(Boolean)\n  .join('\\n\\n')\n  .slice(0, 3900);\n\nif (!videos.length) {\n  throw new Error('WF05 has no videos with local file_path or downloadable URL. Failed: ' + JSON.stringify(failed));\n}\n\nreturn [{ json: {\n  package_id: pkg.id,\n  token,\n  chat_id: chatId,\n  worker_base: workerBase,\n  videos,\n  summary_text: summary,\n  video_count: videos.length,\n  failed_count: failed.length,\n} }];"
      }
    },
    {
      "id": "patchp-05",
      "name": "Supabase: mark delivered",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
