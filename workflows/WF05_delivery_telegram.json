        "jsCode": "const rows = $input.all().flatMap(i => Array.isArray(i.json) ? i.json : [i.json]).filter(r => r && r.id);\nif (!rows.length) return [{ json: { has_package: false, action: 'skip', message: 'No ready packages to deliver.' } }];\nreturn [{ json: { has_package: true, package: rows[0] } }];"
