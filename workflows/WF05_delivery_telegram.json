    },
    {
      "id": "pickp-05",
      "name": "Code: pick ready package",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        280
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().flatMap(i => Array.isArray(i.json) ? i.json : [i.json]).filter(r => r && r.id);\nif (!rows.length) return [{ json: { has_package: false, action: 'skip', message: 'No ready packages to deliver.' } }];\nreturn [{ json: { has_package: true, package: rows[0] } }];"
      }
    },
    {
      "id": "if-05",
      "name": "IF: has package?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        860,
        280
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "has_package",
              "leftValue": "={{ $json.has_package }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      }
    },
    {
      "id": "reada-05",
      "name": "Supabase: read package assets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1140,
        140
      ],
      "parameters": {
        "url": "={{ 'https://xxnzqridvepixzireqjh.supabase.co/rest/v1/package_assets?select=*&daily_package_id=eq.' + $json.package.id + '&asset_type=in.(reel_close,reel_premium,reel_viral,story)&order=created_at.asc' }}",
        "method": "GET",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "{{SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      },
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "send-05",
      "name": "Code: build Telegram requests",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1420,
        140
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const token = \"{{TELEGRAM_BOT_TOKEN}}\";\nconst chatId = \"1347534574\";\nconst pkg = $('Code: pick ready package').first().json.package;\nconst assets = $input.all().flatMap(i => Array.isArray(i.json) ? i.json : [i.json]).filter(a => a && a.id);\nconst order = ['reel_close', 'reel_premium', 'reel_viral', 'story'];\nconst label = { reel_close: 'Reel 1 - close pattern', reel_premium: 'Reel 2 - premium', reel_viral: 'Reel 3 - viral', story: 'Story' };\nconst videos = assets.filter(a => order.includes(a.asset_type)).sort((a, b) => order.indexOf(a.asset_type) - order.indexOf(b.asset_type));\nconst requests = [];\nconst failed = [];\nfunction tgUrl(method) { return 'https://api.telegram.org/bot' + token + '/' + method; }\nfor (const asset of videos) {\n  const url = asset.storage_url || (String(asset.file_path || '').startsWith('http') ? asset.file_path : '');\n  const caption = [label[asset.asset_type] || asset.asset_type, asset.caption || '', asset.cta ? 'CTA: ' + asset.cta : '']\n    .filter(Boolean)\n    .join('\\n\\n')\n    .slice(0, 1000);\n  if (!url) {\n    failed.push({ id: asset.id, asset_type: asset.asset_type, reason: 'No public URL in storage_url/file_path' });\n    continue;\n  }\n  requests.push({\n    package_id: pkg.id,\n    kind: 'video',\n    asset_type: asset.asset_type,\n    telegram_url: tgUrl('sendVideo'),\n    telegram_body: { chat_id: chatId, video: url, caption, supports_streaming: true }\n  });\n}\nconst captionLines = videos.map(asset =>\n  [label[asset.asset_type] || asset.asset_type, asset.caption ? 'Caption: ' + asset.caption : '', asset.cta ? 'CTA: ' + asset.cta : '']\n    .filter(Boolean)\n    .join('\\n')\n);\nconst summary = ['Package ready: ' + (pkg.package_date || pkg.id), '', ...captionLines, '', 'Reply: published 1 2 3, revise second, all ok, send links again.']\n  .join('\\n\\n')\n  .slice(0, 3900);\nrequests.push({\n  package_id: pkg.id,\n  kind: 'summary',\n  asset_type: 'summary',\n  telegram_url: tgUrl('sendMessage'),\n  telegram_body: { chat_id: chatId, text: summary }\n});\nif (failed.length) {\n  requests.push({\n    package_id: pkg.id,\n    kind: 'failure_notice',\n    asset_type: 'failure_notice',\n    telegram_url: tgUrl('sendMessage'),\n    telegram_body: { chat_id: chatId, text: 'Some videos failed: ' + failed.map(f => f.asset_type + ': ' + f.reason).join('; ').slice(0, 3200) }\n  });\n}\nreturn requests.map(r => ({ json: r }));"
      }
    },
    {
      "id": "patchp-05",
      "name": "Supabase: mark delivered",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1700,
        140
      ],
      "parameters": {
        "url": "={{ 'https://xxnzqridvepixzireqjh.supabase.co/rest/v1/daily_packages?id=eq.' + $json.package_id }}",
        "method": "PATCH",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "{{SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({status:'delivered',delivered_at:new Date().toISOString(),updated_at:new Date().toISOString()}) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
