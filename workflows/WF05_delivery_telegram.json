      ],
      "parameters": {
        "url": "https://xxnzqridvepixzireqjh.supabase.co/rest/v1/daily_packages?select=*&status=eq.ready&order=package_date.asc&limit=1",
        "method": "GET",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "{{SUPABASE_SERVICE_ROLE_KEY}}"
