    {
      "id": "send-05",
      "name": "Code: send Telegram videos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1420,
        140
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const token = \"8646017601:AAH4C_nIHvnYqqdBWXVp_BJYxTbQ609nJ4Q\";\nconst chatId = \"1347534574\";\nconst pkg = $('Code: pick ready package').first().json.package;\nconst assets = $input.all().flatMap(i => Array.isArray(i.json) ? i.json : [i.json]).filter(a => a && a.id);\nconst order = ['reel_close', 'reel_premium', 'reel_viral', 'story'];\nconst label = { reel_close: 'Reel 1 - close pattern', reel_premium: 'Reel 2 - premium', reel_viral: 'Reel 3 - viral', story: 'Story' };\nconst videos = assets.filter(a => order.includes(a.asset_type)).sort((a, b) => order.indexOf(a.asset_type) - order.indexOf(b.asset_type));\nconst sent = [];\nconst failed = [];\n\nasync function tg(method, body) {\n  return await $helpers.httpRequest({\n    method: 'POST',\n    url: 'https://api.telegram.org/bot' + token + '/' + method,\n    headers: { 'Content-Type': 'application/json' },\n    body,\n    json: true,\n  });\n}\n\nfor (const asset of videos) {\n  const url = asset.storage_url || (String(asset.file_path || '').startsWith('http') ? asset.file_path : '');\n  const caption = [label[asset.asset_type] || asset.asset_type, asset.caption || '', asset.cta ? 'CTA: ' + asset.cta : '']\n    .filter(Boolean)\n    .join('\\n\\n')\n    .slice(0, 1000);\n  if (!url) {\n    failed.push({ id: asset.id, asset_type: asset.asset_type, reason: 'No public URL in storage_url/file_path' });\n    continue;\n  }\n  try {\n    await tg('sendVideo', { chat_id: chatId, video: url, caption, supports_streaming: true });\n    sent.push({ id: asset.id, asset_type: asset.asset_type, url });\n  } catch (e) {\n    failed.push({ id: asset.id, asset_type: asset.asset_type, url, reason: e.message || String(e) });\n  }\n}\n\nconst captionLines = videos.map(asset =>\n  [label[asset.asset_type] || asset.asset_type, asset.caption ? 'Caption: ' + asset.caption : '', asset.cta ? 'CTA: ' + asset.cta : '']\n    .filter(Boolean)\n    .join('\\n')\n);\nconst summary = ['Package ready: ' + (pkg.package_date || pkg.id), '', ...captionLines, '', 'Reply: published 1 2 3, revise second, all ok, send links again.']\n  .join('\\n\\n')\n  .slice(0, 3900);\nawait tg('sendMessage', { chat_id: chatId, text: summary });\nif (failed.length) {\n  await tg('sendMessage', { chat_id: chatId, text: 'Some videos failed: ' + failed.map(f => f.asset_type + ': ' + f.reason).join('; ').slice(0, 3200) });\n}\n\nreturn [{ json: { package_id: pkg.id, sent_count: sent.length, failed_count: failed.length, sent, failed } }];"
      }
    },
