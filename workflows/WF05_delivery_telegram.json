    {
      "id": "telegram-result-05",
      "name": "Code: Telegram send result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1840,
        140
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const src = $('Code: build Telegram requests').first().json;\nconst response = $input.first().json;\nif (response.ok !== true) {\n  throw new Error('Telegram relay returned not ok: ' + JSON.stringify(response).slice(0, 1000));\n}\nreturn [{ json: { package_id: src.package_id, sent_count: response.sent_count, video_count: src.video_count, telegram_result: response } }];"
      }
    }
