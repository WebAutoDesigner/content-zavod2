    {
      "id": "buildposts-055",
      "name": "Code: build published posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2260,
        120
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const feedback = $('Code: build publish update').item.json.feedback;\nconst assets = $input.all().flatMap(i => Array.isArray(i.json) ? i.json : [i.json]).filter(a => a && a.id);\nconst now = new Date().toISOString();\nconst rows = assets.map(a => ({\n  daily_package_id: feedback.daily_package_id,\n  package_asset_id: a.id,\n  platform: 'instagram',\n  user_reported_published_at: now,\n  success_level: 'unknown',\n  created_at: now,\n  updated_at: now\n}));\nreturn [{ json: { rows } }];"
      }
