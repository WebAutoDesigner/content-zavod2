    {
      "id": "build-llm-055",
      "name": "Code: build feedback LLM prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        280
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $('Webhook: Telegram feedback').item.json.body || {};\nconst msg = body.message?.text || body.text || body.message || JSON.stringify(body);\nconst pkg = Array.isArray($input.first()?.json) ? $input.first().json[0] : $input.first()?.json;\nconst system = [\n  'You parse short natural Russian Telegram commands for a content factory owner.',\n  'Understand profanity, typos, mixed Russian/English, and casual phrases.',\n  'Supported intents: published, revise, approve, reject, archive, ask_status, resend_links.',\n  'Extract target assets if mentioned: reel_1, reel_2, reel_3, story, all, or unknown.',\n  'If user says the post was published, intent=published. If they complain about background/text/cheap look/hook/music/video, intent=revise.',\n  'If confidence is low, use ask_status and explain briefly.',\n  'Return only valid JSON.'\n].join(' ');\nconst schema = {\n  intent: 'published|revise|approve|reject|archive|ask_status|resend_links',\n  target_assets: [],\n  change_request: '',\n  feedback_tags: [],\n  confidence: 0,\n  should_create_published_posts: false,\n  needs_clarification: false,\n  short_reply: ''\n};\nconst user = [\n  'Latest package context:',\n  JSON.stringify({daily_package_id: pkg?.id || null, status: pkg?.status || null, package_date: pkg?.package_date || null}),\n  'Message:',\n  msg,\n  'Return JSON matching schema:',\n  JSON.stringify(schema)\n].join('\\n');\nreturn [{ json: { daily_package_id: pkg?.id || null, raw_message: msg, polza_body: { model: 'openai/gpt-5.2', temperature: 0.1, response_format: { type: 'json_object' }, messages: [{ role: 'system', content: system }, { role: 'user', content: user }] } } }];"
      }
    },
    {
      "id": "polza-055",
      "name": "Polza: GPT-5.2 parse feedback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        860,
        280
      ],
      "parameters": {
        "url": "https://polza.ai/api/v1/chat/completions",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer <POLZA_API_KEY>"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json.polza_body) }}"
      }
    },
    {
      "id": "parse-llm-055",
      "name": "Code: parse feedback LLM",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        280
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const source = $('Code: build feedback LLM prompt').first().json;\nconst response = $input.first()?.json || {};\nconst raw = response.choices?.[0]?.message?.content || response.message?.content || response.content || '';\nfunction parseJson(text) {\n  const clean = String(text || '').trim().replace(/^\\`\\`\\`json\\s*/i, '').replace(/^\\`\\`\\`\\s*/i, '').replace(/\\`\\`\\`$/i, '').trim();\n  try { return JSON.parse(clean); } catch (e) {}\n  const start = clean.indexOf('{'); const end = clean.lastIndexOf('}');\n  if (start >= 0 && end > start) return JSON.parse(clean.slice(start, end + 1));\n  throw new Error('No JSON');\n}\nfunction localFallback(msg) {\n  const s = String(msg || '').toLowerCase();\n  let intent = 'ask_status';\n  if (s.includes('РѕРїСѓР±Р»РёРєРѕРІ') || s.includes('published') || s.includes('РІС‹Р»РѕР¶РёР»') || s.includes('Р·Р°Р»РёР»')) intent = 'published';\n  else if (s.includes('РёСЃРїСЂР°РІ') || s.includes('РїР»РѕС…Рѕ') || s.includes('Р·Р°РјРµРЅРё') || s.includes('РїРµСЂРµРґРµР»') || s.includes('С„РѕРЅ')) intent = 'revise';\n  else if (s.includes('РѕРґРѕР±СЂ') || s === 'РѕРє' || s.includes('approve') || s.includes('РІСЃРµ РѕРє') || s.includes('РІСЃС‘ РѕРє')) intent = 'approve';\n  else if (s.includes('СЃСЃС‹Р»Рє') || s.includes('РµС‰Рµ СЂР°Р·') || s.includes('РµС‰С‘ СЂР°Р·')) intent = 'resend_links';\n  return { intent, target_assets: [], change_request: intent === 'revise' ? msg : '', feedback_tags: [intent], confidence: 0.65, needs_clarification: false, short_reply: '' };\n}\nlet parsed;\ntry { parsed = parseJson(raw); } catch (e) { parsed = localFallback(source.raw_message); }\nconst intent = parsed.intent || parsed.parsed_intent || 'ask_status';\nconst tags = Array.isArray(parsed.feedback_tags) ? parsed.feedback_tags : [intent];\nconst targets = Array.isArray(parsed.target_assets) ? parsed.target_assets : [];\nif (targets.length) tags.push('targets:' + targets.join(','));\nif (parsed.needs_clarification) tags.push('needs_clarification');\nif (parsed.short_reply) tags.push('reply:' + String(parsed.short_reply).slice(0, 300));\nreturn [{\n  json: {\n    daily_package_id: source.daily_package_id,\n    raw_message: source.raw_message,\n    parsed_intent: intent,\n    target_asset_type: targets[0] || null,\n    target_index: null,\n    change_request: parsed.change_request || (intent === 'revise' ? source.raw_message : null),\n    feedback_tags_json: tags,\n    parser_model: raw ? 'openai/gpt-5.2' : 'local-fallback',\n    parser_confidence: Math.max(0, Math.min(1, Number(parsed.confidence || 0.7))),\n    used_for_learning: false\n  }\n}];"
      }
    },
