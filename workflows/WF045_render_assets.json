        "jsCode": "const req = $('Code: build render request').first().json;\nconst response = $input.first()?.json || {};\nconst now = new Date().toISOString();\nconst ok = response.success === true && !!response.file_path;\nconst body = ok ? {\n  file_path: response.file_path,\n  storage_url: response.file_url || null,\n  qc_status: 'passed',\n  qc_notes: 'Rendered by WF04.5 via ' + req.render_tool,\n  duration_seconds: req.render_body?.duration || 12,\n  resolution: '1080x1920',\n  updated_at: now\n} : {\n  qc_status: 'failed',\n  qc_notes: 'Render failed in WF04.5: ' + (response.message || response.error || JSON.stringify(response).slice(0, 500)),\n  updated_at: now\n};\nreturn [{ json: { asset_id: req.asset_id, daily_package_id: req.daily_package_id, ok, update_body: body, render_response: response } }];"
