      "id": "buildrender-045",
      "name": "Code: build render request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1700,
        120
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const picked = $('Code: pick pending asset').first().json;\nconst asset = picked.asset;\nconst packageRows = $('Supabase: read package').all().flatMap(i => Array.isArray(i.json) ? i.json : [i.json]).filter(r => r && r.id);\nconst queueRows = $input.all().flatMap(i => Array.isArray(i.json) ? i.json : [i.json]).filter(r => r && r.id);\nconst pkg = packageRows[0] || {};\nconst queue = queueRows[0] || {};\nconst variant = queue.content_variants || {};\nconst safeText = v => {\n  if (!v) return '';\n  if (typeof v === 'string') return v;\n  try { return JSON.stringify(v); } catch (e) { return String(v); }\n};\nconst arr = v => Array.isArray(v) ? v : [];\nconst screen = typeof variant.screen_text_json === 'string' ? (() => { try { return JSON.parse(variant.screen_text_json); } catch(e) { return []; } })() : variant.screen_text_json;\nconst scenes = typeof variant.scene_plan_json === 'string' ? (() => { try { return JSON.parse(variant.scene_plan_json); } catch(e) { return []; } })() : variant.scene_plan_json;\nconst hook = variant.first_frame || variant.hook_text || asset.caption || '??????, ??? ???????? ????????????';\nconst cta = asset.cta || variant.cta || pkg.cta || '?????? ? ??????, ????? ???????? ???? ????';\nconst textLines = [];\nfor (const x of arr(screen)) textLines.push(safeText(x.text || x.screen_text || x.title || x));\nfor (const x of arr(scenes)) textLines.push(safeText(x.text || x.action || x.visual || x));\nif (!textLines.length && asset.caption) textLines.push(asset.caption);\nconst base = {\n  asset_id: asset.id,\n  daily_package_id: asset.daily_package_id,\n  asset_type: asset.asset_type,\n  content_queue_id: asset.content_queue_id,\n  package_date: pkg.package_date,\n  caption: asset.caption || variant.caption || '',\n  cta,\n};\nlet render_url = 'http://85.239.59.252:8003/render';\nlet render_tool = 'ffmpeg_typewriter';\nlet render_body;\nif (asset.asset_type === 'story' || asset.render_tool === 'playwright' || queue.production_mode === 'story_template') {\n  render_url = 'http://85.239.59.252:8004/render_chat';\n  render_tool = 'playwright_chat';\n  const messages = textLines.slice(0, 6).map((text, i) => ({ from: i % 2 === 0 ? 'client' : 'me', text }));\n  if (!messages.length) messages.push({ from: 'client', text: hook }, { from: 'me', text: cta });\n  render_body = { messages, theme: 'dark_premium', duration: 12 };\n} else if (asset.asset_type === 'reel_premium' || queue.queue_group === 'premium') {\n  render_tool = 'ffmpeg_result_card';\n  render_body = {\n    type: 'result_card',\n    business_name: '???? ?? ?????',\n    metrics: textLines.slice(0, 4),\n    tagline: hook,\n    cta,\n    bg_color: '#0d0d0d',\n    duration: 12,\n    resolution: '1080x1920'\n  };\n} else {\n  render_tool = 'ffmpeg_typewriter';\n  render_body = {\n    type: 'typewriter',\n    hook,\n    texts: textLines.slice(0, 6),\n    solution: cta,\n    bg_color: asset.asset_type === 'reel_viral' ? '#111111' : '#0d0d0d',\n    duration: 12,\n    resolution: '1080x1920'\n  };\n}\nreturn [{ json: { ...base, render_url, render_tool, render_body } }];"
      }
