    {
      "id": "parse-035",
      "name": "Code: parse queue winners",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1420,
        140
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const src = $('Code: normalize variants').item.json;\nconst r = $input.first()?.json || {};\nconst raw = r.choices?.[0]?.message?.content || r.content || '';\nfunction parse(t) {\n  try { return JSON.parse(String(t)); } catch (e) {}\n  const s = String(t || '');\n  return JSON.parse(s.slice(s.indexOf('{'), s.lastIndexOf('}') + 1));\n}\nfunction num(v, d = 50) {\n  v = Number(v);\n  return Number.isFinite(v) ? Math.max(0, Math.min(100, v)) : d;\n}\nlet p;\ntry {\n  p = parse(raw);\n} catch (e) {\n  const by = g => src.variants\n    .filter(v => v.variant_group === g && v.format !== 'caption')\n    .sort((a, b) => String(b.first_frame || '').length - String(a.first_frame || '').length)[0];\n  p = {\n    queue: ['close', 'viral', 'premium', 'story']\n      .map(g => by(g))\n      .filter(Boolean)\n      .map(v => ({\n        variant_id: v.id,\n        queue_group: v.variant_group,\n        priority_score: 70,\n        virality_score: 70,\n        premium_score: 70,\n        similarity_score: 70,\n        first_frame_score: 70,\n        retention_score: 70,\n        lead_score: 70,\n        production_mode: v.variant_group === 'story' ? 'story_template' : 'montage'\n      })),\n    caption_variant_ids: src.variants.filter(v => v.format === 'caption').slice(0, 3).map(v => v.id),\n    notes: 'fallback deterministic selection',\n    score_breakdown_json: { fallback: true }\n  };\n}\nconst now = new Date().toISOString();\nconst rows = (p.queue || []).map((q, i) => ({\n  content_variant_id: q.variant_id,\n  batch_id: src.batch_id,\n  queue_position: i + 1,\n  queue_group: q.queue_group,\n  priority_score: num(q.priority_score),\n  virality_score: num(q.virality_score),\n  premium_score: num(q.premium_score),\n  similarity_score: num(q.similarity_score),\n  first_frame_score: num(q.first_frame_score),\n  retention_score: num(q.retention_score),\n  lead_score: num(q.lead_score),\n  production_mode: q.production_mode || 'montage',\n  status: 'queued',\n  created_at: now,\n  updated_at: now\n}));\nconst ids = [...rows.map(r => r.content_variant_id), ...(p.caption_variant_ids || [])];\nreturn [{ json: { ok: rows.length > 0, pattern_id: src.pattern_id, rows, ids, notes: p.notes || '', score_breakdown_json: p.score_breakdown_json || p } }];"
      }
    },
