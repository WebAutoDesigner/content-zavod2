      ],
      "parameters": {
        "url": "https://xxnzqridvepixzireqjh.supabase.co/rest/v1/content_variants?select=*,content_patterns(*),pattern_recipes(*)&status=eq.idea_created&order=created_at.asc&limit=80",
        "method": "GET",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "<SUPABASE_SERVICE_ROLE_KEY>"
            },
            {
