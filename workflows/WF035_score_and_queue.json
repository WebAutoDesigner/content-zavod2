    {
      "id": "norm-035",
      "name": "Code: normalize variants",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        280
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = $input.all().flatMap(i => Array.isArray(i.json) ? i.json : [i.json]).filter(v => v && v.id);\nif (!raw.length) return [{ json: { has_variants: false, action: 'skip', message: 'No idea_created variants waiting for WF03.5.' } }];\nconst patternId = raw[0].content_pattern_id;\nconst variants = raw.filter(v => v.content_pattern_id === patternId);\nconst system = [\n  'You are the senior SMM director and viral-content judge for a premium-table content factory.',\n  'Your job is to select content that can get reach, retention, leads and still remain safe and unique.',\n  'Do not choose generic ideas. Penalize weak first frames, vague scenes, no proof, no CTA, copied logos/faces/brand identity, and variants too far from a proven competitor pattern.',\n  'The product is premium custom tables. The user usually has little product material, so production must be realistic with competitor-derived mechanics, overlays, simple render formats, and strong first-frame text.',\n  'Return only valid JSON. Output language for notes: Russian.'\n].join(' ');\nconst schema = {\n  queue: [{\n    variant_id: '',\n    queue_group: 'close|viral|premium|story',\n    priority_score: 0,\n    virality_score: 0,\n    premium_score: 0,\n    similarity_score: 0,\n    first_frame_score: 0,\n    retention_score: 0,\n    lead_score: 0,\n    production_mode: '',\n    selection_reason: '',\n    risk_notes: ''\n  }],\n  caption_variant_ids: [],\n  notes: '',\n  score_breakdown_json: {}\n};\nconst user = [\n  'Choose the daily production queue from the variants.',\n  'Need exactly one close reel, one viral reel, one premium reel, one story, and 3 caption variants.',\n  'Scoring priority: virality first, then similarity to successful pattern, then first frame, retention, lead potential, premium feel, uniqueness/safety.',\n  'For each selected item set production_mode: hybrid, typewriter, result_card, story_template, or ai_video. Use ai_video only if materially better; otherwise prefer renderable hybrid/simple formats.',\n  'Reject/downscore exact copied words, exact frames, third-party logo/faces as key element, weak CTA, unclear product desire, or boring first 1-2 seconds.',\n  'Return JSON matching schema:',\n  JSON.stringify(schema),\n  'Variants:',\n  JSON.stringify(variants)\n].join('\\n');\nreturn [{\n  json: {\n    has_variants: true,\n    pattern_id: patternId,\n    batch_id: variants[0].batch_id,\n    variants,\n    polza_body: {\n      model: 'openai/gpt-5.2',\n      temperature: 0.18,\n      response_format: { type: 'json_object' },\n      messages: [\n        { role: 'system', content: system },\n        { role: 'user', content: user }\n      ]\n    }\n  }\n}];"
      }
    },
