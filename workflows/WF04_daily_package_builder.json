      "id": "build-04",
      "name": "Code: build package rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        280
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().flatMap(i => Array.isArray(i.json) ? i.json : [i.json]).filter(r => r && r.id);\nconst pick = g => rows.filter(r => r.queue_group === g)[0];\nconst close = pick('close');\nconst premium = pick('premium');\nconst viral = pick('viral');\nconst story = pick('story');\nif (!close || !premium || !viral || !story) {\n  return [{ json: { ok: false, action: 'skip', message: 'Not enough queued items for daily package.' } }];\n}\nconst today = new Date().toISOString().slice(0, 10);\nconst q = [close, premium, viral, story];\nconst cta = [close, premium, viral].map(x => x.content_variants?.cta).filter(Boolean)[0] || '???пїЅ?????????,?пїЅ ?? ???????пїЅ???,, ???,???пїЅ?< ???пїЅ???пїЅ?,?? ???пїЅ???? ?? ??????????.';\nconst pkg = {\n  package_date: today,\n  status: 'in_production',\n  reel_close_queue_id: close.id,\n  reel_premium_queue_id: premium.id,\n  reel_viral_queue_id: viral.id,\n  story_queue_id: story.id,\n  cta,\n  selection_notes: 'Auto package: close + premium + viral + story. Assets are render specs until WF04 render implementation fills final files.',\n  score_breakdown_json: Object.fromEntries(q.map(x => [x.queue_group, { priority: x.priority_score, virality: x.virality_score, premium: x.premium_score, similarity: x.similarity_score }])),\n  source_refs_json: q.map(x => ({ queue_id: x.id, variant_id: x.content_variant_id, pattern_id: x.content_variants?.content_pattern_id }))\n};\nreturn [{ json: { ok: true, pkg, queue_ids: q.map(x => x.id), items: { close, premium, viral, story } } }];"
      }
    },
