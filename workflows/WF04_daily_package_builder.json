    {
      "id": "readq-04",
      "name": "Supabase: read queued items",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        300,
        280
      ],
      "parameters": {
        "url": "https://xxnzqridvepixzireqjh.supabase.co/rest/v1/content_queue?select=*,content_variants(*)&status=eq.queued&order=priority_score.desc&limit=80",
        "method": "GET",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "{{SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      },
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "build-04",
      "name": "Code: build package rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        280
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().flatMap(i => Array.isArray(i.json) ? i.json : [i.json]).filter(r => r && r.id);\nconst pick = g => rows.filter(r => r.queue_group === g)[0];\nconst close = pick('close');\nconst premium = pick('premium');\nconst viral = pick('viral');\nconst story = pick('story');\nif (!close || !premium || !viral || !story) {\n  return [{ json: { ok: false, action: 'skip', message: 'Not enough queued items for daily package.' } }];\n}\nconst today = new Date().toISOString().slice(0, 10);\nconst q = [close, premium, viral, story];\nconst cta = [close, premium, viral].map(x => x.content_variants?.cta).filter(Boolean)[0] || 'Напишите в директ, чтобы узнать наличие и цену.';\nconst pkg = {\n  package_date: today,\n  status: 'in_production',\n  reel_close_queue_id: close.id,\n  reel_premium_queue_id: premium.id,\n  reel_viral_queue_id: viral.id,\n  story_queue_id: story.id,\n  cta,\n  selection_notes: 'Auto package: close + premium + viral + story. WF04 creates render specs; WF04.5 renders final files.',\n  score_breakdown_json: Object.fromEntries(q.map(x => [x.queue_group, { priority: x.priority_score, virality: x.virality_score, premium: x.premium_score, similarity: x.similarity_score }])),\n  source_refs_json: q.map(x => ({ queue_id: x.id, variant_id: x.content_variant_id, pattern_id: x.content_variants?.content_pattern_id }))\n};\nreturn [{ json: { ok: true, pkg, queue_ids: q.map(x => x.id), items: { close, premium, viral, story } } }];"
      }
    },
    {
      "id": "if-04",
      "name": "IF: can build package?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        860,
        280
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "ok",
              "leftValue": "={{ $json.ok }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "insertpkg-04",
      "name": "Supabase: insert daily package",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1140,
        140
      ],
      "parameters": {
        "url": "https://xxnzqridvepixzireqjh.supabase.co/rest/v1/daily_packages",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "{{SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json.pkg) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "assets-04",
      "name": "Code: build package assets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1420,
        140
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const pkg = Array.isArray($input.first().json) ? $input.first().json[0] : $input.first().json;\nconst src = $items('Code: build package rows')[0].json;\nconst map = { close: 'reel_close', premium: 'reel_premium', viral: 'reel_viral', story: 'story' };\nconst now = new Date().toISOString();\nconst rows = Object.entries(src.items).map(([g, q]) => ({\n  daily_package_id: pkg.id,\n  content_queue_id: q.id,\n  asset_type: map[g],\n  file_path: '/content-factory/packages/' + pkg.package_date + '/' + map[g] + '.mp4',\n  storage_url: null,\n  thumbnail_url: null,\n  duration_seconds: null,\n  resolution: '1080x1920',\n  production_mode: q.production_mode,\n  render_tool: q.production_mode === 'ai_video' ? 'polza_sora_2' : (q.production_mode === 'story_template' ? 'playwright' : 'hybrid'),\n  ai_video_model: q.production_mode === 'ai_video' ? 'openai/sora-2' : null,\n  image_model: 'openai/gpt-image-1.5',\n  music_source: 'competitor_pattern_or_library',\n  caption: q.content_variants?.caption || '',\n  cta: q.content_variants?.cta || src.pkg.cta,\n  qc_status: 'pending',\n  qc_notes: 'Production spec created; WF04.5 must render/fill final file.',\n  created_at: now,\n  updated_at: now\n}));\nrows.push({\n  daily_package_id: pkg.id,\n  content_queue_id: null,\n  asset_type: 'metadata',\n  file_path: '/content-factory/packages/' + pkg.package_date + '/metadata.json',\n  storage_url: null,\n  thumbnail_url: null,\n  duration_seconds: null,\n  resolution: null,\n  production_mode: null,\n  render_tool: null,\n  ai_video_model: null,\n  image_model: null,\n  music_source: null,\n  caption: JSON.stringify(src.pkg),\n  cta: src.pkg.cta,\n  qc_status: 'pending',\n  qc_notes: 'Metadata asset for package references and captions.',\n  created_at: now,\n  updated_at: now\n});\nreturn [{ json: { pkg, queue_ids: src.queue_ids, assets: rows } }];"
      }
    },
