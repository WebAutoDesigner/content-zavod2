      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const pkg=Array.isArray($input.first().json)?$input.first().json[0]:$input.first().json;const src=$('Code: build package rows').item.json;const map={close:'reel_close',premium:'reel_premium',viral:'reel_viral',story:'story'};const now=new Date().toISOString();const rows=Object.entries(src.items).map(([g,q])=>({daily_package_id:pkg.id,content_queue_id:q.id,asset_type:map[g],file_path:'/content-factory/packages/'+pkg.package_date+'/'+map[g]+'.mp4',storage_url:null,thumbnail_url:null,duration_seconds:null,resolution:'1080x1920',production_mode:q.production_mode,render_tool:q.production_mode==='ai_video'?'polza_sora_2':(q.production_mode==='story_template'?'playwright':'hybrid'),ai_video_model:q.production_mode==='ai_video'?'openai/sora-2':null,image_model:'openai/gpt-image-1.5',music_source:'competitor_pattern_or_library',caption:q.content_variants?.caption||'',cta:q.content_variants?.cta||src.pkg.cta,qc_status:'pending',qc_notes:'Production spec created; render endpoint/media generation must fill final file.',created_at:now,updated_at:now}));rows.push({daily_package_id:pkg.id,asset_type:'metadata',file_path:'/content-factory/packages/'+pkg.package_date+'/metadata.json',caption:JSON.stringify(src.pkg),cta:src.pkg.cta,qc_status:'pending',created_at:now,updated_at:now});return[{json:{pkg,queue_ids:src.queue_ids,assets:rows}}];"
